/******************** DIGEST AUTH (CORE) ********************/
function digestFetchJson_(method, url, bodyObj) {
  const m = method.toUpperCase();
  const params = { method: m, followRedirects: true, muteHttpExceptions: true, headers: { 'Accept': 'application/json' } };
  if (bodyObj !== undefined && bodyObj !== null) {
    params.payload = JSON.stringify(bodyObj);
    params.contentType = 'application/json';
  }
  return digestFetchCore_(url, params);
}
function digestFetchCore_(url, params) {
  // 1er intento
  let res = UrlFetchApp.fetch(url, params);
  if (res.getResponseCode() !== 401) return res;

  // Handshake Digest
  const wa = (res.getAllHeaders()['WWW-Authenticate'] || res.getAllHeaders()['Www-Authenticate'] || '').toString();
  const chal = parseDigestChallenge_(wa);
  if (!chal) throw new Error('No se pudo parsear WWW-Authenticate para Digest.');

  const uri = getPathAndQuery_(url);
  const nc  = '00000001';
  const cnonce = randomHex_(16);

  const ha1 = md5hex_(GATEWAY_USER + ':' + chal.realm + ':' + GATEWAY_PASS);
  const ha2 = md5hex_((params.method || 'GET') + ':' + uri);
  const response = md5hex_([ha1, chal.nonce, nc, cnonce, chal.qop, ha2].join(':'));

  const auth = [
    'Digest username="' + GATEWAY_USER + '"',
    'realm="' + chal.realm + '"',
    'nonce="' + chal.nonce + '"',
    'uri="' + uri + '"',
    'qop=' + chal.qop,
    'nc=' + nc,
    'cnonce="' + cnonce + '"',
    'response="' + response + '"',
    'algorithm=MD5'
  ];
  if (chal.opaque) auth.push('opaque="' + chal.opaque + '"');

  const params2 = Object.assign({}, params, {
    headers: Object.assign({}, params.headers || {}, { Authorization: auth.join(', ') })
  });
  res = UrlFetchApp.fetch(url, params2);
  return res;
}
function parseDigestChallenge_(wwwAuth) {
  if (!wwwAuth || wwwAuth.indexOf('Digest') === -1) return null;
  var out = {}, s = wwwAuth.replace(/^Digest\s+/i, ''), rx = /([a-z]+)="?([^",]+)"?/gi, m;
  while ((m = rx.exec(s)) !== null) out[m[1]] = m[2];
  if (out.qop && out.qop.indexOf(',') > -1) out.qop = 'auth';
  return { realm: out.realm, nonce: out.nonce, qop: out.qop || 'auth', opaque: out.opaque };
}

/******************** UTILIDADES ********************/
function findCol_(headers, names) {
  const wants = names.map(normalizeKey_);
  for (let i=0;i<headers.length;i++) if (wants.indexOf(normalizeKey_(headers[i])) >= 0) return i+1;
  return 0;
}
function normalizeKey_(s) {
  return (s || '').toString().normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/\s+/g,' ').trim();
}
function safe_(v) { return v == null ? '' : v; }
function parseJsonSafe_(txt) { try { return JSON.parse(txt || '{}'); } catch (_e) { return {}; } }
function md5hex_(s) {
  const b = Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, s, Utilities.Charset.UTF_8);
  return b.map(n => ((n + 256) & 255).toString(16).padStart(2,'0')).join('');
}
function getPathAndQuery_(full) {
  try { const u = new URL(full); return (u.pathname || '/') + (u.search || ''); }
  catch (_e) { const m = full.match(/^[a-z]+:\/\/[^/]+(\/.*)$/i); return m ? m[1] : '/'; }
}
function randomHex_(len) {
  const chars = 'abcdef0123456789';
  let out = ''; for (let i=0;i<len;i++) out += chars.charAt(Math.floor(Math.random()*chars.length)); return out;
}
